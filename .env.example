# ---------------------------------------------------------------------------
# Copy to .env and fill in. The service fails fast at boot if a required
# variable is missing or malformed (see src/shared/config/env.ts).
# ---------------------------------------------------------------------------

# Postgres connection string.
# The brief names Supabase; any standard Postgres works, including Neon.
# IMPORTANT: use the POOLED endpoint (Neon: the "-pooler" host; Supabase: the
# "session pooler"). The reconciliation property test opens many short queries
# and will exhaust a direct connection.
DATABASE_URL=postgresql://user:password@HOST-pooler.example.neon.tech/dbname?sslmode=require

# HTTP port for the API.
PORT=3000

# Fallback IANA timezone used when a request omits ?tz=. Must be a valid zone.
DEFAULT_TZ=UTC

# --- Source credentials (only needed to sync live data from that source) ----

# Stripe test-mode secret key (starts with sk_test_...). Optional: the CSV
# source and the seed script let the whole system run without it.
STRIPE_SECRET_KEY=

# Razorpay test-mode credentials. Optional, same as above.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Path to the legacy-ERP CSV that the file source reads.
# Generate it with: pnpm make:csv
LEGACY_CSV_PATH=./data/legacy-erp.csv
